# Copy to .env (git-ignored) and fill in. Never commit .env.
# With nothing set, the project runs fully offline with the rule-based explainer.

# auto (default) = groq if GROQ_API_KEY is set, else rule_based
# other values: groq | ollama | openai_compatible | rule_based
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=30

# --- Groq (free tier, recommended hosted option) -------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (100% local and free) ----------------------------------------
# Install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Any other OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM ...) --
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Alerts (optional) -----------------------------------------------------
# Slack / Discord / Microsoft Teams "incoming webhook" URL. Alerts are always
# printed and stored in the warehouse; with this set they are also pushed.
ALERT_WEBHOOK_URL=
